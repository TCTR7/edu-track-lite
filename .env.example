# PostgreSQL Connection (Docker Compose default runs on port 5435 to avoid clashing with local PostgreSQL on 5432/5433)
DATABASE_URL="postgresql://edutrack:edutrack_dev_password@localhost:5435/edutrack_lite"

# Authentication Secret (minimum 32 chars in production)
JWT_SECRET="edutrack-lite-dev-secret-change-in-production-2026"

# App Public URL (used when formatting Zalo login copy message)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dual Storage Adapter: "local" for dev without API keys, "r2" for Cloudflare R2 Presigned URLs
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"

# Cloudflare R2 Settings (Required only when STORAGE_DRIVER="r2")
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="edutrack-lite"
R2_PUBLIC_BASE_URL=""
